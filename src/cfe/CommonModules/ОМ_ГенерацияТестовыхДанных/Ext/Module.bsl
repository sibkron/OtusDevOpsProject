#Область СлужебныеПроцедурыИФункции

Функция СгенерироватьНСИ() Экспорт  
	
	СтруктураНСИ = Новый Структура("Товар, Склад, Контрагент, Валюта, Организация, РасчетыйСчет, РасчетыйСчетКонтрагента");
	
	СтруктураНСИ.Товар = СозданиеТовара("Тест_Хлеб");
	СтруктураНСИ.Склад = СозданиеСправочника("Тест_Склад", "Склады");   
	СтруктураНСИ.Контрагент = СозданиеСправочника("Тест_Контрагент", "Контрагенты");
	СтруктураНСИ.Валюта = СозданиеСправочника("Тест_Валюта", "Валюты");
	СтруктураНСИ.Организация = СозданиеСправочника("Тест_Организация", "Организации");
	СтруктураНСИ.РасчетыйСчет = СозданиеРасчетногоСчета("Тест_РасчетыйСчет", "РасчетныеСчета", СтруктураНСИ.Организация);
	СтруктураНСИ.РасчетыйСчетКонтрагента = СозданиеРасчетногоСчета("Тест_РасчетыйСчетКонтрагента", "РасчетныеСчетаКонтрагентов", СтруктураНСИ.Контрагент);
	
	Возврат СтруктураНСИ;
	
КонецФункции	  			 

Функция ПолучитьОстатокВзаиморасчетов(КонтрагентНовый, ВалютаНовая) Экспорт   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыОстатки.Контрагент КАК Контрагент,
	               |	ВзаиморасчетыОстатки.Валюта КАК Валюта,
	               |	ВзаиморасчетыОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.Взаиморасчеты.Остатки(
	               |			&ДатаСреза,
	               |			Валюта = &Валюта
	               |				И Контрагент = &Контрагент) КАК ВзаиморасчетыОстатки"; 
	Запрос.УстановитьПараметр("Контрагент", КонтрагентНовый);
	Запрос.УстановитьПараметр("Валюта", ВалютаНовая);  
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.СуммаОстаток;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции 

Функция ПолучитьОстатокТоваров(ТоварНовый, СкладНовый) Экспорт   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварныеЗапасыОстатки.Товар КАК Товар,
	               |	ТоварныеЗапасыОстатки.Склад КАК Склад,
	               |	ТоварныеЗапасыОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |ИЗ
	               |	РегистрНакопления.ТоварныеЗапасы.Остатки(
	               |			&ДатаСреза,
	               |			Склад = &Склад
	               |				И Товар = &Товар) КАК ТоварныеЗапасыОстатки"; 
	Запрос.УстановитьПараметр("Товар", ТоварНовый);
	Запрос.УстановитьПараметр("Склад", СкладНовый);  
	Запрос.УстановитьПараметр("ДатаСреза", Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.КоличествоОстаток;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция СозданиеПрихода(Склад, Товар, Цена, Сумма, Количество, КонтрагентНовый, ВалютаНовая) Экспорт   
	
	ПриходТовара = ЮТест.Данные().КонструкторОбъекта("Документы.ПриходТовара")
		.ФикцияОбязательныхПолей()
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Склад", Склад) 
		.Установить("Поставщик", КонтрагентНовый)
		.Установить("Валюта", ВалютаНовая)
		.ФикцияРеквизитов("Организация")
		.ТабличнаяЧасть("Товары").ДобавитьСтроку()
			.Установить("Товар", Товар)
			.Установить("Цена", Цена)
			.Установить("Количество", Количество)
			.Установить("Сумма", Сумма)
		.Провести(Истина)
		;
		
	Возврат ПриходТовара;	
	
КонецФункции  

Функция СозданиеОплаты(Организация, РасчетныйСчет, РасчетныйСчетПоставщика, Сумма, Поставщик, Валюта) Экспорт
	
	Оплата = ЮТест.Данные().КонструкторОбъекта("Документы.Оплата")
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Организация", Организация) 
		.Установить("Поставщик", Поставщик)
		.Установить("Валюта", Валюта)
		.Установить("РасчетныйСчет", РасчетныйСчет)
		.Установить("РасчетныйСчетПоставщика", РасчетныйСчетПоставщика) 
		.Установить("Сумма", Сумма)
		.Провести(Истина)
		;
		
	Возврат Оплата;	
	
КонецФункции

Функция СозданиеПоступленияДенег(Организация, РасчетныйСчет, РасчетныйСчетПокупателя, Сумма, Покупатель, Валюта) Экспорт
	
