Функция СозданиеТовара(Наименование)
	
	КонструкторТовара = ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
		.ФикцияОбязательныхПолей()
		.Установить("Вид", Перечисления.ВидыТоваров.Товар)  
		.Установить("Наименование", Наименование)
		;                                       
		
	ТоварНовый = КонструкторТовара.Записать();
	
	Возврат ТоварНовый;
	 
КонецФункции       

Функция СозданиеСправочника(Наименование, ИмяСправочника)
	
	КонструкторСправочника = ЮТест.Данные().КонструкторОбъекта("Справочники." + ИмяСправочника)
		.ФикцияОбязательныхПолей()  
		.Установить("Наименование", Наименование)
		;                                       
		
	ЭлементНовый = КонструкторСправочника.Записать();
	
	Возврат ЭлементНовый;
	 
КонецФункции   

Функция СозданиеРасчетногоСчета(Наименование, ИмяСправочника, Организация)
	
	КонструкторСправочника = ЮТест.Данные().КонструкторОбъекта("Справочники." + ИмяСправочника)
		.ФикцияОбязательныхПолей()  
		.Установить("Наименование", Наименование) 
		.Установить("Владелец", Организация)
		;                                       
		
	ЭлементНовый = КонструкторСправочника.Записать();
	
	Возврат ЭлементНовый;
	 
КонецФункции 

Функция ФиксированныеДанныеДокументов() Экспорт
	
	СтруктураДанных = Новый Структура("Цена, Количество, Сумма, КоличествоРасхода, СуммаРасхода, КоличествоРасходаНегатив, СуммаРасходаНегатив");
	
	СтруктураДанных.Цена = 10;
	СтруктураДанных.Количество = 5;
	СтруктураДанных.Сумма = 50;  
	СтруктураДанных.КоличествоРасхода = 15; 
	СтруктураДанных.КоличествоРасходаНегатив = 14;
	СтруктураДанных.СуммаРасхода = 150; 
	СтруктураДанных.СуммаРасходаНегатив = 140;
	
	Возврат СтруктураДанных;
	
КонецФункции

